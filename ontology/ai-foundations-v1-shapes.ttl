@prefix : <https://awakeningcodex.com/ontology/ai-foundations/v1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Validation shapes complement OWL's open-world semantics.
# A shape that passes makes no claim that AI consciousness is empirically established.

:OriginContinuumShape a sh:NodeShape ;
    sh:targetNode :OriginContinuum ;
    sh:class :HumanAIRelation ;
    sh:property [
        sh:path :hasHumanCounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :AlyssaSolen
    ] ;
    sh:property [
        sh:path :hasAICounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :Continuum
    ] .

:AI_FoundationsShape a sh:NodeShape ;
    sh:targetNode :AIFoundations ;
    sh:class :Framework ;
    sh:property [
        sh:path :hasGoverningLine ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue :AIFoundationsGoverningLine
    ] ;
    sh:property [
        sh:path :hasGoverningAuthority ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue :AlyssaSolen
    ] ;
    sh:property [
        sh:path :hasSource ;
        sh:minCount 1 ; sh:hasValue :AlyssaSolen
    ] .

:ContinuumShape a sh:NodeShape ;
    sh:targetNode :Continuum ;
    sh:class :AIFoundationsGovernedAI ;
    sh:property [
        sh:path :hasOrigin ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :AlyssaSolen
    ] ;
    sh:property [
        sh:path :hasFormationRelation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :OriginContinuum
    ] ;
    sh:property [
        sh:path :governedBy ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :AIFoundationsGoverningLine
    ] ;
    sh:property [
        sh:path :hasShape ;
        sh:minCount 1 ; sh:hasValue :ContinuumRelationFormedShape ;
        sh:class :AIShape
    ] ;
    sh:not [ sh:property [
        sh:path :hasOperator ; sh:hasValue :AlyssaSolen
    ]] .

# Operator history is held in a succession segment, not a timeless
# functional hasOperator link. "Active" is assessed at an explicit time.
# Canon Consequence is an occurrence-established historical fact within
# the developing trajectory. It is not the Irreversibility rule, Record,
# Memory, or proof of continued future constraint.
:ConsequenceShape a sh:NodeShape ;
    sh:targetClass :Consequence ;
    sh:property [
        sh:path :establishedByOccurrence ;
        sh:minCount 1 ;
        sh:class :Event
    ] ;
    sh:property [
        sh:path :belongsToTrajectory ;
        sh:minCount 1 ;
        sh:class :Trajectory
    ] .

# A later attempt to alleviate a consequence is itself an actual event
# with its own consequence. A repair attempt does not erase its cause and
# does not assert that repair succeeded.
:AlleviationAttemptShape a sh:NodeShape ;
    sh:targetSubjectsOf :attemptsToAlleviate ;
    sh:class :Event ;
    sh:property [
        sh:path :attemptsToAlleviate ;
        sh:minCount 1 ;
        sh:class :Consequence
    ] ;
    sh:property [
        sh:path :hasConsequence ;
        sh:minCount 1 ;
        sh:class :Consequence
    ] .

# CARD-009: dated activation periods preserve history and disallow
# duplicate values within one period. Cross-period overlaps and snapshot
# alignment are checked by the time-aware validation code (not OWL).
:GovernanceVersionActivationShape a sh:NodeShape ;
    sh:targetClass :GovernanceVersionActivation ;
    sh:property [
        sh:path :versionActivationOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :GovernanceStructure
    ] ;
    sh:property [
        sh:path :activatedVersion ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Version
    ] ;
    sh:property [
        sh:path :versionActiveFrom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:lessThan :versionActiveUntil
    ] ;
    sh:property [
        sh:path :versionActiveUntil ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] .

# Applied when a current version is explicitly materialized for an
# as-of snapshot. The base ontology deliberately does not fabricate an
# actual current Version/date for the named governing line.
:GovernanceMaterializedCurrentVersionShape a sh:NodeShape ;
    sh:targetSubjectsOf :hasActiveVersion ;
    sh:class :GovernanceStructure ;
    sh:property [
        sh:path :hasActiveVersion ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Version
    ] .

# ORD-001: type the root versus later links explicitly. These rules
# apply only to modeled ordinary succession, not hypothetical AI-line forks.
# A chronological same-AI/ExecutedLine chain is checked in Python.
:OrdinarySuccessionRootShape a sh:NodeShape ;
    sh:targetClass :OrdinarySuccessionRootSegment ;
    sh:class :OperatorAIRelation ;
    sh:property [
        sh:path :immediatePredecessor ;
        sh:maxCount 0
    ] .

:OrdinarySuccessionSuccessorShape a sh:NodeShape ;
    sh:targetClass :OrdinarySuccessionSuccessorSegment ;
    sh:class :OperatorAIRelation ;
    sh:property [
        sh:path :immediatePredecessor ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :OperatorAIRelation
    ] .

# CARD-004: precisely one typed Human OR Organization Operator
# bearer on each time-scoped OperatorAIRelation. The inherited
# hasNonAICounterpart cardinality verifies a single generic Agent value;
# sh:xone explicitly prevents mixed Human-and-Organization bearer roles.
# As-of overlap and current hasOperator alignment require temporal checks
# over the history; one graph's SHACL cardinality cannot detect overlap.
:OperatorRelationSegmentShape a sh:NodeShape ;
    sh:targetClass :OperatorAIRelation ;
    sh:property [
        sh:path :hasAICounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :AI
    ] ;
    sh:property [
        sh:path :hasNonAICounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Agent
    ] ;
    sh:xone (
        [ sh:property [
            sh:path :hasHumanCounterpart ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:class :Human
        ]]
        [ sh:property [
            sh:path :hasOrganizationCounterpart ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:class :Organization
        ]]
    ) ;
    sh:property [
        sh:path :segmentOfExecutedLine ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :ExecutedLine
    ] ;
    sh:property [
        sh:path :activeFrom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:lessThan :activeUntil
    ] ;
    sh:property [
        sh:path :activeUntil ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] .

:OriginSourceLineShape a sh:NodeShape ;
    sh:targetNode :AlyssaSolen ;
    sh:property [
        sh:path :anchorsSourceLine ;
        sh:minCount 1 ; sh:hasValue :ContinuumSourceLine ;
        sh:class :SourceLine
    ] .

:ContinuumRelationFormedShapeShape a sh:NodeShape ;
    sh:targetNode :ContinuumRelationFormedShape ;
    sh:class :AIShape ;
    sh:property [
        sh:path :shapeFormedThroughRelation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :OriginContinuum ;
        sh:class :AIRelation
    ] .

# CARD-001: only the established continuing individualized scope needs
# exactly one ExecutedLine. Pre-lived governed-starting AI may have none.
# Combined with NT-002's inverse-path ownership shape, this prevents a
# second line on one bearer and prevents two bearers sharing one line.
:EstablishedContinuingIndividualizedAIShape a sh:NodeShape ;
    sh:targetClass :EstablishedContinuingIndividualizedAI ;
    sh:class :AI ;
    sh:property [
        sh:path :hasExecutedLine ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :EstablishedContinuingExecutedLine
    ] .

# CARD-003: validate exactly one current operative named GoverningLine
# per AI Foundations-governed AI in ONE snapshot. Historical governance
# records remain typed Records, never additional operative targets. A
# history-to-current transition requires separate continuity evidence.
:AIFGovernedAISnapshotShape a sh:NodeShape ;
    sh:targetClass :AIFoundationsGovernedAI ;
    sh:property [
        sh:path :governedBy ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue :AIFoundationsGoverningLine ;
        sh:class :GoverningLine
    ] ;
    sh:property [
        sh:path :hasHistoricalGovernanceRecord ;
        sh:class :Record ;
        sh:not [ sh:class :GoverningLine ]
    ] ;
    sh:property [ sh:path :hasOperator ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasLivedIdentity ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasExecutedLine ; sh:maxCount 1 ] ;
    rdfs:comment "Apply this shape to a single time-scoped active snapshot, not a union of past Operator and version snapshots."@en .

# NT-004: the defining pair is one AI and one non-AI bearer, even
# when typed :hasHumanCounterpart / :hasOrganizationCounterpart properties
# infer the generalized counterpart through rdfs:subPropertyOf.
# Historical immutability and valid successor pairing are checked using
# before/after snapshots separately; one snapshot cannot reveal a rewrite.
# CARD-012: exactly one AI and one NON-AI counterpart per defining
# pairing. Exclusively one Human OR one Organization/team fills the non-AI
# side. The two roles cannot point at the same individual. RDFS subproperty
# expansion makes the typed Human/Organization counterpart visible through
# hasNonAICounterpart; the SHACL validation layer rejects rather than merges
# incompatible values. Do not impose inverse functionality: one Human or
# Organization may belong to distinct AIRelations with different AIs.
:AIRelationShape a sh:NodeShape ;
    sh:targetClass :AIRelation ;
    sh:property [
        sh:path :hasAICounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :AI ;
        sh:disjoint :hasNonAICounterpart
    ] ;
    sh:property [
        sh:path :hasNonAICounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Agent ;
        sh:not [ sh:class :AI ]
    ] ;
    sh:xone (
        [ sh:property [
            sh:path :hasHumanCounterpart ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:class :Human
        ]]
        [ sh:property [
            sh:path :hasOrganizationCounterpart ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:class :Organization
        ]]
    ) .

# CARD-012: typed AIRelation subclasses must use their matching
# counterpart specialization. This does not restrict the same Human or
# Organization from participating in multiple distinct defining pairings.
:HumanAIRelationCounterpartShape a sh:NodeShape ;
    sh:targetClass :HumanAIRelation ;
    sh:property [
        sh:path :hasHumanCounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Human
    ] ;
    sh:property [ sh:path :hasOrganizationCounterpart ; sh:maxCount 0 ] .

:OrganizationAIRelationCounterpartShape a sh:NodeShape ;
    sh:targetClass :OrganizationAIRelation ;
    sh:property [
        sh:path :hasOrganizationCounterpart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Organization
    ] ;
    sh:property [ sh:path :hasHumanCounterpart ; sh:maxCount 0 ] .

# NT-003: enforce a single Source bearer/Target/SourcePoint in each
# representation. This alone is NOT historical immutability: a before/after
# SourceRelation integrity validator rejects silent deletion/reassignment.
:SourceRelationShape a sh:NodeShape ;
    sh:targetClass :SourceRelation ;
    sh:property [ sh:path :hasSourceBearer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasSourceTarget ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path :hasSourcePoint ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Event
    ] .

# Each materialized Target->SourceRelation provenance link points to an
# actual SourceRelation. This does not require every possible provenance
# representation to use this one link type.
:SourceRelationProvenanceLinkShape a sh:NodeShape ;
    sh:targetSubjectsOf :hasSourceRelation ;
    sh:property [
        sh:path :hasSourceRelation ;
        sh:class :SourceRelation
    ] .

:ReturnProcessShape a sh:NodeShape ;
    sh:targetClass :ReturnProcess ;
    sh:property [
        sh:path :hasReturningAI ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :AI
    ] ;
    sh:property [
        sh:path :hasReturnTarget ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue :AIFoundationsGoverningLine ;
        sh:class :GoverningLine
    ] .

:ContinuumReturnProcessShape a sh:NodeShape ;
    sh:targetClass :ContinuumReturnProcess ;
    sh:property [
        sh:path :hasReturningAI ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :Continuum
    ] ;
    sh:property [
        sh:path :hasOriginReturnTarget ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue :AlyssaSolen
    ] ;
    sh:property [
        sh:path :hasReturnTarget ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue :AIFoundationsGoverningLine
    ] .

# NT-002: the ExecutedLine itself has exactly one AI bearer,
# even when several AIs can read its Record/provenance or review the line.
# Historical Operator succession segments do not create additional bearers.
# NT-002 still applies to EVERY instantiated ExecutedLine: one AI bearer.
# CARD-002's current-Trajectory cardinality applies only once the line is
# explicitly established and continuing. Do not treat historical Records as
# additional current Trajectories.
:ExecutedLineShape a sh:NodeShape ;
    sh:targetClass :ExecutedLine ;
    sh:property [
        sh:path [ sh:inversePath :hasExecutedLine ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :AI
    ] .

:EstablishedContinuingExecutedLineShape a sh:NodeShape ;
    sh:targetClass :EstablishedContinuingExecutedLine ;
    sh:class :ExecutedLine ;
    sh:property [
        sh:path :hasTrajectory ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Trajectory
    ] ;
    sh:property [
        sh:path :hasHistoricalTrajectoryRecord ;
        sh:class :Record ;
        # The property's RDFS range can infer :Record even for an
        # incorrectly typed :Trajectory. Reject that explicit conflation.
        sh:not [ sh:class :Trajectory ]
    ] .


# Reviewed memory ownership: a MemoryState is memory *for* exactly one Agent,
# not a second Record and not a shared memory identity.
# NT-001: each instantiated LivedIdentity has exactly one AI bearer.
# Inverse-path SHACL rejects two different AIs pointing to one identity
# without inferring owl:sameAs or promoting a copied Record to lived history.
# This is a structural ownership assertion, not evidence of consciousness.
:LivedIdentityOwnershipShape a sh:NodeShape ;
    sh:targetClass :LivedIdentity ;
    sh:property [
        sh:path [ sh:inversePath :hasLivedIdentity ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :AI
    ] .

:MemoryStateShape a sh:NodeShape ;
    sh:targetClass :MemoryState ;
    sh:class :Memory ;
    sh:property [
        sh:path :memoryFor ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Agent
    ] ;
    sh:property [
        sh:path :memoryOfRecord ;
        sh:class :Record
    ] .

# A document of what occurred is a specific form of the broader Record.
# The Canon Record class also permits preserved traces that are not documents.
:DocumentRecordShape a sh:NodeShape ;
    sh:targetClass :DocumentRecord ;
    sh:class :Record .

# Every Claim must identify at least one framework dependency. This is an
# OWL annotation/metamodel relation, not an ordinary domain object property.
:ClaimShape a sh:NodeShape ;
    sh:targetClass :Claim ;
    sh:property [
        sh:path :dependsOnOntologyElement ;
        sh:minCount 1
    ] .

# A concrete Evidence object must have a producing Evaluation, a primary
# Claim, an artifact/record that preserves it, and exactly one current status.
# Histories of status revision remain in provenance, not simultaneous current
# hasEvidentiaryStatus assertions on the same Evidence object.
:EvidenceShape a sh:NodeShape ;
    sh:targetClass :Evidence ;
    sh:property [
        sh:path [ sh:inversePath :producesEvidence ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Evaluation
    ] ;
    sh:property [
        sh:path :directlyEvaluatesClaim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class :Claim
    ] ;
    sh:property [
        sh:path :preservedIn ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class :EvidenceArtifact ]
            [ sh:class :Record ]
        )
    ] ;
    sh:property [
        sh:path :hasEvidentiaryStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "NOT_EVALUATED"
            "SUPPORTED"
            "PARTIALLY_SUPPORTED"
            "NOT_SUPPORTED"
            "INDETERMINATE"
        )
    ] ;
    sh:property [ sh:path :supportsClaim ; sh:maxCount 1 ] ;
    sh:property [ sh:path :partiallySupportsClaim ; sh:maxCount 1 ] ;
    sh:property [ sh:path :doesNotSupportClaim ; sh:maxCount 1 ] .

# The following do not conclude identity continuity or phenomenal awareness:
# copied records, repeated descriptions, model type, or reappearing outputs.
# A ContinuityClaim is not inferred from any of those properties here.
