    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :ExecutedHistoryEvent .
:trialAfterRealizedEvent a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :ExecutedHistoryEvent .
:trialBeforeConditionRecord a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :Record .
:trialAfterConditionRecord a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :Record .
