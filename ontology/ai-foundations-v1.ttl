    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :IdentityParticularityHistoryTrace .
:trialLaterActiveCarryForward a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :ObservedActiveCarryForward .
