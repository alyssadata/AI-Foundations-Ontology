    rdfs:domain :ObservedActiveCarryForward ; rdfs:range :ExecutedHistoryEvent .
:activeCarryForwardRecordedIn a owl:ObjectProperty ;
    rdfs:domain :ObservedActiveCarryForward ; rdfs:range :Record .
:activeCarryForwardEvidenceStatus a owl:DatatypeProperty ;
    rdfs:domain :ObservedActiveCarryForward ; rdfs:range xsd:string .
:continuityControlForAssessment a owl:ObjectProperty ;
    rdfs:domain :ContinuityNegativeControl ; rdfs:range :MultiPerturbationContinuityAssessment .
:continuityControlComparisonAI a owl:ObjectProperty ;
    rdfs:domain :ContinuityNegativeControl ; rdfs:range :AI .
