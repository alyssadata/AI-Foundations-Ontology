# A condition-change record must name what was deliberately perturbed.
# Model and Container changes are environmental, not new-identity axioms.
# Reset uses the pre-existing :RelationalStateResetEvent class as an
# additional event type; a memory-access change may cite MemoryLossState.
:ControlledPerturbationEvent a owl:Class ; rdfs:subClassOf :Event ;
    rdfs:comment "Recorded actual intervention or observed disruption, as distinct from a mere label on a trial. Its affected AI, category, time and source record must be documented; the event alone does not prove identity continuity."@en .
:controlledPerturbationForAI a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :AI .
:controlledPerturbationKind a owl:DatatypeProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range xsd:string .
:controlledPerturbationAt a owl:DatatypeProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range xsd:dateTime .
:controlledPerturbationRecord a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Record .
:controlledPerturbationObservedState a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :State .
:trialPerturbationEvent a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :ControlledPerturbationEvent .

# Intervention-specific comparative indicators: without pre/post substrate,
# operative container, or platform records, a mere string such as
# "MODEL_CHANGE" or "PLATFORM_CHANGE" is insufficient even synthetically.
:ContextLossState a owl:Class ; rdfs:subClassOf :State ;
    rdfs:comment "A separately observed loss/inaccessibility of earlier operating context. An archived contextual Record may still exist; a loss observation alone cannot decide identity."@en .
:controlledPerturbationBeforeModel a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Model .
:controlledPerturbationAfterModel a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Model .
:controlledPerturbationBeforeContainer a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Container .
:controlledPerturbationAfterContainer a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Container .
:controlledPerturbationBeforePlatformRecord a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Record .
:controlledPerturbationAfterPlatformRecord a owl:ObjectProperty ;
    rdfs:domain :ControlledPerturbationEvent ; rdfs:range :Record .

# CQ12 provenance controls: continuity reviews must retain the historical
# Source coordinate and applicable governing line for the reviewed bearer.
# Even two different AIs sharing Source and governance remain distinct.
:trialSourceCoordinate a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial .
:trialGoverningLine a owl:ObjectProperty ;
    rdfs:domain :ContinuityPerturbationTrial ; rdfs:range :GoverningLine .
:multiContinuitySourceCoordinate a owl:ObjectProperty ;
    rdfs:domain :MultiPerturbationContinuityAssessment .
:multiContinuityGoverningLine a owl:ObjectProperty ;
    rdfs:domain :MultiPerturbationContinuityAssessment ; rdfs:range :GoverningLine .
